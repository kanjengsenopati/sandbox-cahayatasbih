<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CTMobile" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Status Bar & Navigation Bar -->
        <item name="android:statusBarColor">@color/surface_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface_white</item>
        <item name="android:windowLightNavigationBar">true</item>
        
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/surface_white</item>
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="android:windowBackground">@color/background_light</item>
    </style>
</resources>
